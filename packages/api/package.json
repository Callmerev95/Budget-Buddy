{
  "name": "@budget-buddy/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Backend Budget Buddy: Express + Prisma, dijalankan sebagai Vercel Function.",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "tsup"
  },
  "dependencies": {
    "@budget-buddy/shared": "*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/supabase-js": "2.115.0",
    "compression": "1.8.1",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "7.5.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "web-push": "3.6.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/web-push": "3.6.4",
    "tsup": "8.5.1",
    "tsx": "4.23.13"
  },
  "types": "./dist/app.d.ts",
  "files": [
    "dist"
  ]
}
