# ── Database (Supabase Postgres) ────────────────────────────────────────────
# Runtime: Supavisor transaction pooler, port 6543, wajib pakai pgbouncer=true.
DATABASE_URL="postgresql://prisma.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrasi: koneksi session mode, port 5432.
DIRECT_URL="postgresql://prisma.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
# Host pooler (aws-0 vs aws-1) berbeda per project, ambil dari dashboard
# Supabase menu Connect. User `prisma` adalah role khusus dengan atribut
# bypassrls + createdb, sesuai dokumentasi Supabase untuk Prisma.

# ── Supabase (server) ───────────────────────────────────────────────────────
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="publishable_or_anon_key"

# ── Aplikasi ────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=5000
APP_URL="http://localhost:5173"
# Hanya untuk pengembangan lokal. Di produksi web dan API satu origin,
# jadi biarkan kosong.
CORS_ORIGINS="http://localhost:5173"

# ── Web Push (opsional) ─────────────────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# ── Vercel Cron ─────────────────────────────────────────────────────────────
# Minimal 16 karakter. Vercel mengirimkannya sebagai Authorization: Bearer.
CRON_SECRET=""

# ── Supabase (client, di-bundle ke browser) ─────────────────────────────────
VITE_SUPABASE_URL="https://PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="publishable_or_anon_key"
